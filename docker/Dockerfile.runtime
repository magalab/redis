# Build Redis from the selected upstream tag, then publish only runtime files.

FROM debian:trixie AS builder

WORKDIR /workspace
ENV DEBIAN_FRONTEND=noninteractive
ARG REDIS_REF=unstable

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates gcc g++ libc6-dev libssl-dev make pkg-config git && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${REDIS_REF}" \
      https://github.com/redis/redis.git /workspace

RUN make -j"$(nproc)" BUILD_TLS=yes

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --home-dir /data --create-home redis

COPY --from=builder /workspace/src/redis-server /usr/local/bin/redis-server
COPY --from=builder /workspace/src/redis-cli /usr/local/bin/redis-cli
COPY --from=builder /workspace/src/redis-benchmark /usr/local/bin/redis-benchmark
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

WORKDIR /data
VOLUME ["/data"]
EXPOSE 6379
USER redis
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["redis-server"]
