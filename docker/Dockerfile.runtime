# Build Redis from this checkout, then publish only the runtime artifacts.

FROM ubuntu:24.04 AS builder

WORKDIR /workspace
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates gcc g++ libc6-dev libssl-dev make pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY . .

RUN make -j"$(nproc)" BUILD_TLS=yes

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --home-dir /data --create-home redis

COPY --from=builder /workspace/src/redis-server /usr/local/bin/redis-server
COPY --from=builder /workspace/src/redis-cli /usr/local/bin/redis-cli
COPY --from=builder /workspace/src/redis-benchmark /usr/local/bin/redis-benchmark

WORKDIR /data
VOLUME ["/data"]
EXPOSE 6379
USER redis
ENTRYPOINT ["redis-server"]
